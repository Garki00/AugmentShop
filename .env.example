# ---------- 数据库 ----------
# docker-compose 里由 mysql 服务提供；本地直跑时会自动退回 SQLite（backend/data/kjds.db）
DATABASE_URL=mysql+pymysql://kjds:kjds123456@mysql:3306/kjds?charset=utf8mb4
# 本地不带 docker 跑后端时可放开下面这行
# DATABASE_URL=sqlite:///D:/AAAAGarki/Sonnet/kjds/backend/data/kjds.db

# ---------- 鉴权 ----------
JWT_SECRET=kjds-demo-secret-change-me
JWT_TTL_HOURS=168
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- AI（SiliconFlow） ----------
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=your-api-key
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# 对话模型复用同一个 key / base_url
CHAT_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_TIMEOUT=60
AI_MAX_TOKENS=700

# ---------- 其它 ----------
RECOMMEND_LIMIT=5
PAGE_SIZE_DEFAULT=18
SEED_ON_START=1
